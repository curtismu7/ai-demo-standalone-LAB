# Optional. Everything has a safe default; the demo needs no tenant and no credentials.
# PORT must be 7810 (this app's one allocated port).
PORT=7810
# AIDEMOLAB_BIND=127.0.0.1   # loopback only unless you set this on purpose
AIDEMOLAB_SERVER_KEY=

# Real token exchange (owner-run). When set, the shell's Mock | Real toggle switches to Real and the
# real PingOne RFC 8693 exchange (third-party JWT as the actor token) is available on POST /api/real-exchange.
# The subject and actor tokens are supplied per request in the UI; the client secret stays in this file.
# AIDEMOLAB_REAL_URL=https://<PingOne auth host>/<environment id>/as/token (e.g. the auth host of your region: auth . pingone . com without the spaces)
# AIDEMOLAB_REAL_CLIENT_ID=<exchanging app client id>
# AIDEMOLAB_REAL_CLIENT_SECRET=<write-only; never returned>

# ---- P10: Real SIGN-IN (login only; data stays mock). Owner-run: these names never ship. ----
# pingone (default) or pingfederate
AIDEMOLAB_SIGNIN_PROVIDER=
# the OAuth client the lab signs in with (a public/confidential app whose redirect list has http://127.0.0.1:7810/callback)
AIDEMOLAB_SIGNIN_CLIENT_ID=
AIDEMOLAB_SIGNIN_CLIENT_SECRET=
# the username the Sign in dialog prefills (PingOne pi.flow drives the flows API password step)
AIDEMOLAB_SIGNIN_USERNAME=
# PingFederate only: the PF base URL (e.g. https://local.ping-devops.com:9031); PingOne uses PINGONE_ENVIRONMENT_ID/REGION above
AIDEMOLAB_SIGNIN_BASE_URL=
